+static void set_seeked(lavf_priv_t *priv)
+{
+    for (int n = 0; n < priv->num_streams; n++)
+        priv->streams[n]->seeked = true;
+}
+
+static void mvc_clear(lavf_priv_t *priv)
+{
+    for (int n = 0; n < priv->num_mvc_dep_q; n++)
+        av_packet_free(&priv->mvc_dep_q[n]);
+    for (int n = 0; n < priv->num_mvc_base_q; n++)
+        av_packet_free(&priv->mvc_base_q[n]);
+    priv->num_mvc_dep_q = priv->num_mvc_base_q = 0;
+    priv->mvc_dep_pos = -1;
+    priv->mvc_eof = false;
+}
+
+// Whether a base view's packet starts an IDR picture.
+static bool mvc_is_idr(const uint8_t *d, int size)
+{
+    for (int i = 3; i < size; i++) {
+        if (d[i - 1] == 1 && !d[i - 2] && !d[i - 3]) {
+            int type = d[i] & 0x1f;
+            if (type == 5)
+                return true;
+            if (type == 1)
+                return false;
+        }
+    }
+    return false;
+}
+
+// The next base view's packet, joined with the dependent view's of the same
+// DTS (or alone, which the decoder treats as damage).
+static bool mvc_join(lavf_priv_t *priv, AVPacket *pkt)
+{
+    while (priv->num_mvc_base_q) {
+        AVPacket *base = priv->mvc_base_q[0];
+        AVPacket *dep = priv->num_mvc_dep_q ? priv->mvc_dep_q[0] : NULL;
+        if (dep && dep->dts == base->dts) {
+            // It may go on in the next packet (read_frame()): whole once
+            // another one starts.
+            if (priv->num_mvc_dep_q < 2 && !priv->mvc_eof &&
+                priv->num_mvc_base_q < MVC_MAX_WAITING)
+                return false;
+            int size = base->size;
+            if (av_grow_packet(base, dep->size) >= 0)
+                memcpy(base->data + size, dep->data, dep->size);
+            av_packet_free(&priv->mvc_dep_q[0]);
+            MP_TARRAY_REMOVE_AT(priv->mvc_dep_q, priv->num_mvc_dep_q, 0);
+        } else if (dep && dep->dts < base->dts) {
+            av_packet_free(&priv->mvc_dep_q[0]);
+            MP_TARRAY_REMOVE_AT(priv->mvc_dep_q, priv->num_mvc_dep_q, 0);
+            continue;
+        } else if (!dep && !priv->mvc_eof &&
+                   priv->num_mvc_base_q < MVC_MAX_WAITING) {
+            return false;
+        }
+        av_packet_move_ref(pkt, base);
+        av_packet_free(&priv->mvc_base_q[0]);
+        MP_TARRAY_REMOVE_AT(priv->mvc_base_q, priv->num_mvc_base_q, 0);
+        if (mvc_is_idr(pkt->data, pkt->size))
+            pkt->flags |= AV_PKT_FLAG_KEY;
+        return true;
+    }
+    return false;
+}
+
+// av_read_frame(), with MVC's two views joined.
+static int read_frame(struct demuxer *demux, AVPacket *pkt)
+{
+    lavf_priv_t *priv = demux->priv;
+
+    if (priv->mvc_dep < 0 || priv->mvc_base < 0)
+        return av_read_frame(priv->avfc, pkt);
+
+    while (!mvc_join(priv, pkt)) {
+        if (priv->mvc_eof)
+            return AVERROR_EOF;
+        int r = av_read_frame(priv->avfc, pkt);
+        if (r == AVERROR_EOF) {
+            priv->mvc_eof = true;
+            continue;
+        }
+        if (r < 0)
+            return r;
+        AVPacket ***q = NULL;
+        int *num = NULL;
+        if (pkt->stream_index == priv->mvc_dep) {
+            q = &priv->mvc_dep_q;
+            num = &priv->num_mvc_dep_q;
+        } else if (pkt->stream_index == priv->mvc_base) {
+            q = &priv->mvc_base_q;
+            num = &priv->num_mvc_base_q;
+        } else {
+            return 0;
+        }
+        // FFmpeg's TS demuxer hands out a PES packet over max_packet_size
+        // (200 KiB) in pieces, from the same position, the later ones with
+        // made-up timestamps. The base view's parser joins its own; the
+        // dependent view has none (a big picture's).
+        if (q == &priv->mvc_dep_q && pkt->pos >= 0 && pkt->pos == priv->mvc_dep_pos) {
+            AVPacket *last = *num ? (*q)[*num - 1] : NULL;
+            if (last && last->pos == pkt->pos) {
+                int size = last->size;
+                if (av_grow_packet(last, pkt->size) >= 0)
+                    memcpy(last->data + size, pkt->data, pkt->size);
+            }
+            av_packet_unref(pkt);
+            continue;
+        }
+        if (q == &priv->mvc_dep_q)
+            priv->mvc_dep_pos = pkt->pos;
+        if ((q == &priv->mvc_dep_q && pkt->dts == AV_NOPTS_VALUE) ||
+            *num >= MVC_MAX_WAITING)
+        {
+            av_packet_unref(pkt);
+            continue;
+        }
+        AVPacket *queued = av_packet_alloc();
+        MP_HANDLE_OOM(queued);
+        av_packet_move_ref(queued, pkt);
+        MP_TARRAY_APPEND(priv, *q, *num, queued);
+    }
+    return 0;
+}
