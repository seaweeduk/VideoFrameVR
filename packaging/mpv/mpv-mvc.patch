+#define MVC_BASE_PID 0x1011
+#define MVC_DEPENDENT_PID 0x1012
+// Packets of one view kept waiting for the other's (about 10 s).
+#define MVC_MAX_WAITING 256
+// Seconds from one IDR access unit to the next, at most (Blu-ray: 1).
+#define MVC_SEEK_BACK 1.0
+
+static bool is_mvc_ts_stream(lavf_priv_t *priv, AVStream *st, int pid)
+{
+    return st->id == pid && st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO &&
+           matches_avinputformat_name(priv, "mpegts");
+}
+
+// Whether a stream is a Blu-ray's MVC dependent view: never a track.
+static bool is_mvc_dependent(lavf_priv_t *priv, AVStream *st)
+{
+    if (!is_mvc_ts_stream(priv, st, MVC_DEPENDENT_PID))
+        return false;
+    if (priv->mvc_ts && st->codecpar->codec_id == AV_CODEC_ID_NONE)
+        return true;
+    // Found too late to be joined; its packets aren't usable alone.
+    if (st->codecpar->codec_id != AV_CODEC_ID_H264)
+        return false;
+    for (int n = 0; n < priv->avfc->nb_streams; n++) {
+        AVStream *base = priv->avfc->streams[n];
+        if (is_mvc_ts_stream(priv, base, MVC_BASE_PID) &&
+            base->codecpar->codec_id == AV_CODEC_ID_H264)
+            return true;
+    }
+    return false;
+}
