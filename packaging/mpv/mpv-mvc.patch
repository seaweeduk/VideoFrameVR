+
+// Each packet holds both views of one access unit (a Matroska block, or a
+// transport stream's two views joined by demux_lavf). video/decode/mvc/
+// rewrites it as plain H.264 pictures, each sent to the decoder as a packet
+// of its own and tagged through its pts. The decoder's output is paired
+// again by tag (base + dependent view, hidden pictures dropped) into one
+// frame with the access unit's timestamps: both views side by side, the left
+// eye's first, each at full size.
+//
+// The decoder must not drop frames (every picture may be a reference) and is
+// opened without extradata (the rewritten pictures carry their parameter
+// sets). Streams the rewrite can't handle play the base view in 2D.
+
+struct AVPacket;
+struct demux_packet;
+struct mp_codec_params;
+struct mp_image;
+struct mp_log;
+struct vd_mvc;
+
+// Whether the stream's parameters say it is two-view MVC: views joined by the
+// demuxer, or an mvcC box after the avcC record (Matroska CodecPrivate).
+bool vd_mvc_by_params(struct mp_codec_params *c);
+// Whether a packet holds a dependent view's NAL units (MVC without mvcC).
+bool vd_mvc_in_packet(struct mp_codec_params *c, struct demux_packet *pkt);
+
+// base_right: the base view is the right eye's. NULL when out of memory.
+// Free with talloc_free().
+struct vd_mvc *vd_mvc_create(void *talloc_ctx, struct mp_log *log,
+                             struct mp_codec_params *c, bool base_right);
+
+// Rewrites a packet (NULL: end of stream) into decoder packets. False: the
+// stream can't be rewritten, or no access unit could be for a few seconds;
+// play the base view (vd_mvc_strip) from here on.
+bool vd_mvc_send(struct vd_mvc *m, struct demux_packet *pkt);
+// The next packet to send to the decoder: true while there is one. *pkt is
+// NULL for the end of the stream (send a flush). It stays until vd_mvc_pop().
+bool vd_mvc_next(struct vd_mvc *m, struct AVPacket **pkt);
+void vd_mvc_pop(struct vd_mvc *m);
+
+// A decoded picture whose AVFrame.pts is `tag`. Takes it; returns the access
+// unit's frame once both views are there, otherwise NULL.
+struct mp_image *vd_mvc_frame(struct vd_mvc *m, struct mp_image *img,
+                              int64_t tag);
+
+// Seek or flush: forgets queued packets and half pairs, and waits for the
+// next IDR access unit.
+void vd_mvc_reset(struct vd_mvc *m);
+
+// The SPS ids a stream's packets showed so far, a bit per id: the base
+// view's SPSs and subset SPSs (vd_mvc_strip() tells PPSs apart by them).
+struct vd_mvc_sps_ids {
+    uint32_t base, subset;
+};
+
+// The packet without the dependent view's NAL units, so that a plain H.264
+// decoder sees the base view only; NULL if it has none (or out of memory).
+// length_size: NAL length field size of length-prefixed input, 0 for Annex B.
+// ids: the stream's, kept from packet to packet. Free with av_packet_free().
+struct AVPacket *vd_mvc_strip(const struct AVPacket *pkt, int length_size,
+                              struct vd_mvc_sps_ids *ids);
+// The NAL length size of a stream's packets (0: Annex B).
+int vd_mvc_length_size(struct mp_codec_params *c);
