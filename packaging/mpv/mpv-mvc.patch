+#include "video/decode/mvc/mvc_rewrite.h"
+#include "vd_mvc.h"
+
+// Access units whose timestamps are kept until their pictures are decoded:
+// the rewrite holds up to 16, the decoder's reorder delay and pipeline some
+// more.
+#define AU_RING 256
+
+// Access units dropped in a row (no dependent view, or damage that no IDR
+// recovers from) before playing the base view in 2D: a few seconds, well
+// beyond the wait for an IDR after a seek.
+#define GIVE_UP_DROPS 150
+
+struct au_time {
+    int64_t seq;
+    double pts, dts, duration;
+};
+
+struct vd_mvc {
+    struct mp_log *log;
+    struct mvc_rewriter *rw;
+    bool base_right;
+    struct au_time ring[AU_RING];
+    int64_t seq;             // the last access unit's
+    struct AVPacket **queue; // rewritten pictures waiting for the decoder
+    int num_queue, queue_head;
+    bool queue_eof;          // a flush follows the queue
+    int drops;               // access units dropped since the last good one
+    struct mp_image *held;   // a base view waiting for its dependent view
+    int64_t held_seq;
+    struct mp_image_pool *pool;
+};
+
+// Packet pts as passed through the decoder: the access unit, and the slot.
+static int64_t make_tag(int64_t seq, enum mvc_slot slot)
+{
+    return seq * 4 + slot;
+}
+
+// Calls fn for each NAL unit: its type, and the bytes from its start code or
+// length field to the next one. Stops when fn returns false.
+static void for_each_nal(const uint8_t *d, size_t n, int length_size,
+                         bool (*fn)(void *ctx, int type, size_t start, size_t end),
+                         void *ctx)
+{
+    if (length_size) {
+        size_t pos = 0;
+        while (pos + length_size < n) {
+            size_t len = 0;
+            for (int i = 0; i < length_size; i++)
+                len = (len << 8) | d[pos + i];
+            size_t end = pos + length_size + len;
+            if (!len || end > n)
+                return;
+            if (!fn(ctx, d[pos + length_size] & 0x1f, pos, end))
+                return;
+            pos = end;
+        }
+        return;
+    }
+    // Annex B: a unit starts at its start code's first zero byte.
+    size_t start = SIZE_MAX, header = 0;
+    size_t pos = 2;
+    while (pos < n) {
+        const uint8_t *one = memchr(d + pos, 1, n - pos);
+        if (!one)
+            break;
+        size_t at = one - d;
+        pos = at + 1;
+        if (d[at - 1] || d[at - 2])
+            continue;
+        size_t code = at >= 3 && !d[at - 3] ? at - 3 : at - 2;
+        if (start != SIZE_MAX && !fn(ctx, d[header] & 0x1f, start, code))
+            return;
+        start = code;
+        header = at + 1;
+        if (header >= n)
+            return;
+        pos = header;
+    }
+    if (start != SIZE_MAX && header < n)
+        fn(ctx, d[header] & 0x1f, start, n);
+}
+
+// The codec private data (libavformat's demuxers keep it in lav_codecpar).
+static int get_extradata(struct mp_codec_params *c, const uint8_t **data)
+{
+    if (c->lav_codecpar) {
+        *data = c->lav_codecpar->extradata;
+        return c->lav_codecpar->extradata_size;
+    }
+    *data = c->extradata;
+    return c->extradata_size;
+}
+
+int vd_mvc_length_size(struct mp_codec_params *c)
+{
+    const uint8_t *d;
+    int size = get_extradata(c, &d);
+    if (size >= 7 && d[0] == 1)
+        return (d[4] & 3) + 1;
+    return 0;
+}
+
+bool vd_mvc_by_params(struct mp_codec_params *c)
+{
+    if (!c->codec || strcmp(c->codec, "h264") != 0)
+        return false;
+    if (c->mvc)
+        return true;
+    const uint8_t *d;
+    int size = get_extradata(c, &d);
+    if (size < 7 || d[0] != 1)
+        return false;
+    // avcC is followed by its own box; mvcC's type sits after its size.
+    for (int i = 7; i + 4 <= size; i++) {
+        if (!memcmp(d + i, "mvcC", 4))
+            return true;
+    }
+    return false;
+}
+
+static bool find_slice_ext(void *ctx, int type, size_t start, size_t end)
+{
+    if (type == 20 || type == 15) {
+        *(bool *)ctx = true;
+        return false;
+    }
+    return true;
+}
+
+bool vd_mvc_in_packet(struct mp_codec_params *c, struct demux_packet *pkt)
+{
+    if (!pkt || !pkt->len || !c->codec || strcmp(c->codec, "h264") != 0)
+        return false;
+    bool found = false;
+    for_each_nal(pkt->buffer, pkt->len, vd_mvc_length_size(c), find_slice_ext,
+                 &found);
+    return found;
+}
+
+static void clear_queue(struct vd_mvc *m)
+{
+    for (int i = m->queue_head; i < m->num_queue; i++)
+        av_packet_free(&m->queue[i]);
+    m->num_queue = m->queue_head = 0;
+    m->queue_eof = false;
+}
+
+static void destroy(void *p)
+{
+    struct vd_mvc *m = p;
+    clear_queue(m);
+    talloc_free(m->held);
+    mvc_rewriter_destroy(m->rw);
+}
+
+struct vd_mvc *vd_mvc_create(void *talloc_ctx, struct mp_log *log,
+                             struct mp_codec_params *c, bool base_right)
+{
+    const uint8_t *extradata;
+    int size = get_extradata(c, &extradata);
+    struct mvc_rewriter *rw = mvc_rewriter_create(extradata, MPMAX(size, 0));
+    if (!rw)
+        return NULL;
+    struct vd_mvc *m = talloc_zero(talloc_ctx, struct vd_mvc);
+    talloc_set_destructor(m, destroy);
+    m->log = log;
+    m->rw = rw;
+    m->base_right = base_right;
+    m->pool = mp_image_pool_new(m);
+    return m;
+}
+
+static bool queue_pictures(struct vd_mvc *m, const struct mvc_picture *pics,
+                           int count)
+{
+    for (int i = 0; i < count; i++) {
+        AVPacket *pkt = av_packet_alloc();
+        if (!pkt || av_new_packet(pkt, pics[i].size) < 0) {
+            av_packet_free(&pkt);
+            return false;
+        }
+        memcpy(pkt->data, pics[i].data, pics[i].size);
+        pkt->pts = make_tag(pics[i].tag, pics[i].slot);
+        if (pics[i].idr)
+            pkt->flags |= AV_PKT_FLAG_KEY;
+        if (m->queue_head && m->queue_head == m->num_queue)
+            m->num_queue = m->queue_head = 0;
+        MP_TARRAY_APPEND(m, m->queue, m->num_queue, pkt);
+    }
+    return true;
+}
+
+bool vd_mvc_send(struct vd_mvc *m, struct demux_packet *pkt)
+{
+    const struct mvc_picture *pics = NULL;
+    int count = 0;
+    if (!pkt) {
+        mvc_rewriter_flush(m->rw, &pics, &count);
+        queue_pictures(m, pics, count);
+        m->queue_eof = true;
+        return true;
+    }
+    int64_t seq = ++m->seq;
+    m->ring[seq % AU_RING] = (struct au_time){
+        .seq = seq,
+        .pts = pkt->pts,
+        .dts = pkt->dts,
+        .duration = pkt->duration,
+    };
+    enum mvc_status st = mvc_rewrite(m->rw, pkt->buffer, pkt->len, seq,
+                                     &pics, &count);
+    if (st == MVC_UNSUPPORTED) {
+        MP_WARN(m, "Can't decode this 3D (MVC) video in 3D (%s); "
+                   "playing it in 2D.\n", mvc_rewriter_reason(m->rw));
+        return false;
+    }
+    if (!queue_pictures(m, pics, count))
+        st = MVC_NO_MEMORY;
+    if (st == MVC_OK) {
+        if (m->drops)
+            MP_VERBOSE(m, "Dropped %d access units.\n", m->drops);
+        m->drops = 0;
+        return true;
+    }
+    if (!m->drops++)
+        MP_VERBOSE(m, "Dropping access units: %s\n", mvc_rewriter_reason(m->rw));
+    if (m->drops >= GIVE_UP_DROPS) {
+        MP_WARN(m, "No 3D (MVC) picture in %d access units (%s); "
+                   "playing the video in 2D.\n", m->drops,
+                mvc_rewriter_reason(m->rw));
+        return false;
+    }
+    return true;
+}
+
+bool vd_mvc_next(struct vd_mvc *m, struct AVPacket **pkt)
+{
+    *pkt = m->queue_head < m->num_queue ? m->queue[m->queue_head] : NULL;
+    return *pkt || m->queue_eof;
+}
+
+void vd_mvc_pop(struct vd_mvc *m)
+{
+    if (m->queue_head < m->num_queue) {
+        av_packet_free(&m->queue[m->queue_head]);
+        if (++m->queue_head == m->num_queue)
+            m->num_queue = m->queue_head = 0;
+    } else {
+        m->queue_eof = false;
+    }
+}
+
+void vd_mvc_reset(struct vd_mvc *m)
+{
+    clear_queue(m);
+    TA_FREEP(&m->held);
+    mvc_rewriter_reset(m->rw);
+    m->drops = 0;
+}
+
+static struct mp_image *crop_view(struct mp_image *img)
+{
+    if (mp_image_crop_valid(&img->params))
+        mp_image_crop_rc(img, img->params.crop);
+    return img;
+}
+
+// Both views of an access unit as one frame, the left eye's on the left.
+static struct mp_image *compose(struct vd_mvc *m, struct mp_image *base,
+                                struct mp_image *dep)
+{
+    // Hardware frames are not composed: vd_lavc decodes MVC to software
+    // frames only (copy-back).
+    if (base->hwctx || dep->hwctx || base->imgfmt != dep->imgfmt) {
+        MP_ERR(m, "Can't join views of format %s and %s.\n",
+               mp_imgfmt_to_name(base->imgfmt), mp_imgfmt_to_name(dep->imgfmt));
+        return NULL;
+    }
+    struct mp_image views[2] = {*base, *dep};
+    crop_view(&views[0]);
+    crop_view(&views[1]);
+    int w = views[0].w, h = views[0].h;
+    if (views[1].w != w || views[1].h != h || (w & (base->fmt.align_x - 1))) {
+        MP_ERR(m, "Views differ in size: %dx%d and %dx%d.\n", w, h,
+               views[1].w, views[1].h);
+        return NULL;
+    }
+    struct mp_image *out = mp_image_pool_get(m->pool, base->imgfmt, 2 * w, h);
+    if (!out)
+        return NULL;
+    mp_image_copy_attributes(out, base);
+    out->params.crop = (struct mp_rect){0, 0, 2 * w, h};
+    out->params.stereo3d = MP_STEREO3D_SBS2L;
+    for (int eye = 0; eye < 2; eye++) {
+        struct mp_image half = *out;
+        mp_image_crop(&half, eye * w, 0, (eye + 1) * w, h);
+        mp_image_copy(&half, &views[eye ^ m->base_right]);
+    }
+    return out;
+}
+
+struct mp_image *vd_mvc_frame(struct vd_mvc *m, struct mp_image *img,
+                              int64_t tag)
+{
+    if (tag == AV_NOPTS_VALUE || tag < 0) {
+        talloc_free(img);
+        return NULL;
+    }
+    int64_t seq = tag / 4;
+    int slot = tag % 4;
+    if (slot == MVC_SLOT_BASE) {
+        if (m->held)
+            MP_VERBOSE(m, "Dropping a view without its pair.\n");
+        talloc_free(m->held);
+        m->held = img;
+        m->held_seq = seq;
+        return NULL;
+    }
+    if (slot != MVC_SLOT_DEPENDENT) {
+        talloc_free(img);
+        return NULL;
+    }
+    struct mp_image *base = m->held;
+    m->held = NULL;
+    if (!base || m->held_seq != seq) {
+        MP_VERBOSE(m, "Dropping a view without its pair.\n");
+        talloc_free(base);
+        talloc_free(img);
+        return NULL;
+    }
+    struct mp_image *out = compose(m, base, img);
+    talloc_free(base);
+    talloc_free(img);
+    if (!out)
+        return NULL;
+    struct au_time *t = &m->ring[seq % AU_RING];
+    bool known = t->seq == seq;
+    out->pts = known ? t->pts : MP_NOPTS_VALUE;
+    out->dts = known ? t->dts : MP_NOPTS_VALUE;
+    out->pkt_duration = known ? t->duration : -1;
+    return out;
+}
+
+struct strip_ctx {
+    const uint8_t *src;
+    uint8_t *dst;
+    size_t size;
+    int length_size;
+    bool any;
+    bool base_slice;    // a base view slice came before
+    struct vd_mvc_sps_ids *ids;
+};
+
+// The first Exp-Golomb values of a NAL unit's payload from byte skip on, or
+// false if they aren't in its first bytes.
+static bool read_ids(const uint8_t *p, size_t n, size_t skip, uint32_t *v,
+                     int count)
+{
+    uint8_t rbsp[16];
+    size_t size = 0;
+    int zeros = 0;
+    for (size_t i = 0; i < n && size < sizeof(rbsp); i++) {
+        if (zeros >= 2 && p[i] == 3) {
+            zeros = 0;
+            continue;
+        }
+        zeros = p[i] ? 0 : zeros + 1;
+        rbsp[size++] = p[i];
+    }
+    if (size <= skip)
+        return false;
+    struct bitreader br;
+    br_init(&br, rbsp + skip, size - skip);
+    for (int i = 0; i < count; i++)
+        v[i] = br_ue(&br);
+    return !br.overrun;
+}
+
+// Which view a NAL unit belongs to: the subset SPS, the dependent view's
+// slices, prefixes and delimiter, the PPSs of a subset SPS that is no base
+// view SPS too, and SEI after the base view's slices (it can't follow its
+// own picture's slices) are the dependent view's.
+static bool dependent_nal(struct strip_ctx *s, int type, const uint8_t *p,
+                          size_t n)
+{
+    uint32_t id[2];
+    switch (type) {
+    case 1:
+    case 5:
+        s->base_slice = true;
+        return false;
+    case 7:
+    case 15:
+        // profile_idc, constraint flags and level_idc, then the id
+        if (read_ids(p, n, 3, id, 1) && id[0] < 32)
+            *(type == 7 ? &s->ids->base : &s->ids->subset) |= 1u << id[0];
+        return type == 15;
+    case 8:
+        return read_ids(p, n, 0, id, 2) && id[1] < 32 &&
+               (s->ids->subset & (1u << id[1])) && !(s->ids->base & (1u << id[1]));
+    case 6:
+        return s->base_slice;
+    case 14:
+    case 20:
+    case 24:
+        return true;
+    }
+    return false;
+}
+
+static bool strip_nal(void *ctx, int type, size_t start, size_t end)
+{
+    struct strip_ctx *s = ctx;
+    // The header byte: after the length field, or the start code.
+    size_t h = start + s->length_size;
+    if (!s->length_size) {
+        while (h < end && !s->src[h])
+            h++;
+        h++;
+    }
+    if (h < end && dependent_nal(s, type, s->src + h + 1, end - h - 1)) {
+        s->any = true;
+    } else {
+        memcpy(s->dst + s->size, s->src + start, end - start);
+        s->size += end - start;
+    }
+    return true;
+}
+
+struct AVPacket *vd_mvc_strip(const struct AVPacket *pkt, int length_size,
+                              struct vd_mvc_sps_ids *ids)
+{
+    AVPacket *out = av_packet_alloc();
+    if (!out || av_new_packet(out, pkt->size) < 0 ||
+        av_packet_copy_props(out, pkt) < 0)
+    {
+        av_packet_free(&out);
+        return NULL;
+    }
+    struct strip_ctx s = {.src = pkt->data, .dst = out->data,
+                          .length_size = length_size, .ids = ids};
+    for_each_nal(pkt->data, pkt->size, length_size, strip_nal, &s);
+    if (!s.any) {
+        av_packet_free(&out);
+        return NULL;
+    }
+    av_shrink_packet(out, s.size);
+    return out;
+}
