# Let another thread interrupt a V4L2 decoder waiting for its caller to return a
# capture buffer, so the caller can take its decoding thread back (to flush).
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -1329,8 +1329,11 @@ void ff_v4l2_context_release(V4L2Context* ctx)
     av_freep(&ctx->bufrefs);
     av_buffer_unref(&ctx->frames_ref);
 
+    pthread_mutex_lock(&ctx_to_m2mctx(ctx)->interrupt_lock);
+    ctx->sync_ready = 0;
     ff_mutex_destroy(&ctx->lock);
     pthread_cond_destroy(&ctx->cond);
+    pthread_mutex_unlock(&ctx_to_m2mctx(ctx)->interrupt_lock);
 }
 
 
@@ -1532,6 +1535,9 @@ int ff_v4l2_context_init(V4L2Context* ctx)
     if (ret < 0)
         goto fail_unlock;
 
+    pthread_mutex_lock(&s->interrupt_lock);
+    ctx->sync_ready = 1;
+    pthread_mutex_unlock(&s->interrupt_lock);
     return 0;
 
 fail_unlock:
--- a/libavcodec/v4l2_context.h
+++ b/libavcodec/v4l2_context.h
@@ -121,6 +121,8 @@ typedef struct V4L2Context {
 
     AVBufferRef *frames_ref;
     atomic_int q_count;
+    /* lock and cond exist (set under V4L2m2mContext.interrupt_lock) */
+    int sync_ready;
     struct ff_weak_link_master *wl_master;
 
     AVMutex lock;
--- a/libavcodec/v4l2_m2m.c
+++ b/libavcodec/v4l2_m2m.c
@@ -334,6 +334,7 @@ static void v4l2_m2m_destroy_context(void *opaque, uint8_t *context)
 
     ff_v4l2_context_release(&s->capture);
     sem_destroy(&s->refsync);
+    pthread_mutex_destroy(&s->interrupt_lock);
 
     if (s->fd >= 0)
         close(s->fd);
@@ -434,10 +435,13 @@ int ff_v4l2_m2m_create_context(V4L2m2mPriv *priv, V4L2m2mContext **pps)
     *pps = NULL;
     if (!s)
         return AVERROR(ENOMEM);
+    pthread_mutex_init(&s->interrupt_lock, NULL);
+    atomic_init(&s->interrupted, 0);
 
     priv->context_ref = av_buffer_create((uint8_t *)s, sizeof(*s),
                                          &v4l2_m2m_destroy_context, NULL, 0);
     if (!priv->context_ref) {
+        pthread_mutex_destroy(&s->interrupt_lock);
         av_free(s);
         return AVERROR(ENOMEM);
     }
--- a/libavcodec/v4l2_m2m.h
+++ b/libavcodec/v4l2_m2m.h
@@ -130,6 +130,12 @@ typedef struct V4L2m2mContext {
     int iris_staged_eligible;
     struct v4l2_format iris_capture_format;
 
+    /* Set from another thread (av_v4l2_m2m_set_interrupted()): a decoder
+     * waiting for its caller to return a capture buffer gives up instead.
+     * interrupt_lock covers the queues' lock and cond while they exist. */
+    atomic_int interrupted;
+    pthread_mutex_t interrupt_lock;
+
     /* Ext data sent */
     int extdata_sent;
     /* Ext data sent in packet - overrides ctx */
@@ -222,6 +228,19 @@ int ff_v4l2_m2m_codec_reinit(V4L2m2mContext *ctx);
  */
 int ff_v4l2_m2m_codec_full_reinit(V4L2m2mContext *ctx);
 
+/**
+ * Exported for callers that decode on one thread and return frames on
+ * another: while interrupted, a V4L2 decoder that has no capture buffer
+ * left (all of them held as decoded frames) returns AVERROR(EAGAIN) from
+ * receive_frame at once instead of waiting for one to be returned. The
+ * caller sets it from any thread before it needs the decoding thread back
+ * (e.g. to flush) and clears it once it has it. Must not race with
+ * avcodec_open2() or avcodec_free_context() of avctx.
+ *
+ * @returns 0, or AVERROR(ENOSYS) if avctx is not an open V4L2 decoder
+ */
+int av_v4l2_m2m_set_interrupted(AVCodecContext *avctx, int interrupted);
+
 
 static inline unsigned int ff_v4l2_get_format_width(const struct v4l2_format * const fmt)
 {
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -656,6 +656,13 @@ static int qbuf_wait(AVCodecContext * const avctx, V4L2Context * const ctx)
             until.tv_nsec %= 1000000000;
             err = pthread_cond_timedwait(&ctx->cond, &ctx->lock, &until);
         } else {
+            // Only the caller returning a frame frees a buffer here, so a
+            // caller that needs this thread first (to flush) interrupts it.
+            // Checked under the lock its broadcast takes: never missed.
+            if (atomic_load(&s->interrupted)) {
+                rv = AVERROR(EINTR);
+                break;
+            }
             err = pthread_cond_wait(&ctx->cond, &ctx->lock);
         }
         if (err != 0) {
@@ -669,6 +676,31 @@ static int qbuf_wait(AVCodecContext * const avctx, V4L2Context * const ctx)
     return rv;
 }
 
+int av_v4l2_m2m_set_interrupted(AVCodecContext *avctx, int interrupted)
+{
+    V4L2m2mContext *s;
+
+    if (!avctx || !avctx->codec || !av_codec_is_decoder(avctx->codec) ||
+        !avctx->codec->wrapper_name || strcmp(avctx->codec->wrapper_name, "v4l2m2m") ||
+        !avcodec_is_open(avctx) || !avctx->priv_data)
+        return AVERROR(ENOSYS);
+    s = ((V4L2m2mPriv *)avctx->priv_data)->context;
+    if (!s)
+        return AVERROR(ENOSYS);
+
+    atomic_store(&s->interrupted, !!interrupted);
+    if (interrupted) {
+        pthread_mutex_lock(&s->interrupt_lock);
+        if (s->capture.sync_ready) {
+            ff_mutex_lock(&s->capture.lock);
+            pthread_cond_broadcast(&s->capture.cond);
+            ff_mutex_unlock(&s->capture.lock);
+        }
+        pthread_mutex_unlock(&s->interrupt_lock);
+    }
+    return 0;
+}
+
 static int v4l2_receive_frame(AVCodecContext *avctx, AVFrame *frame)
 {
     V4L2m2mContext *const s = ((V4L2m2mPriv*)avctx->priv_data)->context;
@@ -728,6 +760,11 @@ static int v4l2_receive_frame(AVCodecContext *avctx, AVFrame *frame)
                 // Wait & retry
                 if ((dst_rv = qbuf_wait(avctx, &s->capture)) == 0) {
                     dst_rv = ff_v4l2_context_dequeue_frame(&s->capture, frame, t);
+                } else if (dst_rv == AVERROR(EINTR)) {
+                    // No frame now; the caller calls again once it is done.
+                    av_frame_unref(frame);
+                    s->req_pkt = 0;
+                    return AVERROR(EAGAIN);
                 }
             }
 
