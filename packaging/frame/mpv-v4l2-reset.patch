+static void stop_releaser(struct priv *p)
+{
+    pthread_mutex_lock(&p->lock);
+    p->quit = true;
+    pthread_mutex_unlock(&p->lock);
+    uint64_t one = 1;
+    if (write(p->wake_fd, &one, sizeof(one)) < 0) {
+        // the thread polls its eventfd: it cannot be full
+    }
+    pthread_join(p->releaser, NULL);
+    for (int i = 0; i < p->num_held; i++) {
+        if (!wait_fd(p->held[i].fd) && !finish_draws(p))
+            continue;
+        close(p->held[i].fd);
+        mp_image_unrefp(&p->held[i].mpi);
+    }
+    p->num_held = 0;
+    pthread_cond_destroy(&p->freed);
+    pthread_mutex_destroy(&p->lock);
+    close(p->wake_fd);
