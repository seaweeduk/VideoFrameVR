+// mpv lets go of a frame once it draws the next one, and a V4L2 decoder
+// writes a new picture into the frame's buffer at once, without waiting for
+// the GPU's reads. With the GPU behind (the app's eye passes queued ahead of
+// this draw) parts of a later picture were drawn, now and then a torn frame.
+// So a drawn hardware frame stays referenced until a fence after its draw.
+static void hold_drawn(struct render_backend *ctx, struct vo_frame *frame)
+{
+    struct priv *p = ctx->priv;
+    struct mp_image *mpi = frame->current;
+    GL *gl = held_gl(p);
+    if (!mpi || mpi->imgfmt != IMGFMT_DRMPRIME || !gl || !gl->FenceSync)
+        return;
+    if (!p->fences_checked)
+        check_fence_fds(ctx, p);
+    if (p->fence_fds) {
+        int fd = fence_fd(p);
+        struct mp_image *ref = fd >= 0 ? mp_image_new_ref(mpi) : NULL;
+        if (!ref) {
+            // Not held, so wait for the draw rather than risk a torn frame.
+            if (fd >= 0)
+                close(fd);
+            gl->Finish();
+            return;
+        }
+        pthread_mutex_lock(&p->lock);
+        struct timespec until;
+        clock_gettime(CLOCK_REALTIME, &until);
+        until.tv_sec += 1;
+        while (p->num_held == MP_ARRAY_SIZE(p->held) &&
+               pthread_cond_timedwait(&p->freed, &p->lock, &until) == 0) {}
+        bool full = p->num_held == MP_ARRAY_SIZE(p->held);
+        if (!full)
+            p->held[p->num_held++] = (struct held_frame){.mpi = ref, .fd = fd};
+        pthread_mutex_unlock(&p->lock);
+        if (full) {
+            if (!wait_fd(fd) && !finish_draws(p))
+                return;  // keep ref and fd alive rather than recycle an unfinished draw
+            close(fd);
+            mp_image_unrefp(&ref);
+            return;
+        }
+        uint64_t one = 1;
+        if (write(p->wake_fd, &one, sizeof(one)) < 0) {
+            // the thread polls its eventfd: it cannot be full
+        }
+        return;
+    }
+    struct held_frame *last = p->num_held ? &p->held[p->num_held - 1] : NULL;
+    if (last && last->mpi->planes[0] == mpi->planes[0]) {
+        // drawn again: until the newer draw is done
+        if (last->fence)
+            gl->DeleteSync(last->fence);
+        last->fence = gl->FenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+        return;
+    }
+    if (p->num_held == MP_ARRAY_SIZE(p->held)) {
+        struct held_frame *h = &p->held[0];
+        GLenum r = h->fence ? gl->ClientWaitSync(h->fence, GL_SYNC_FLUSH_COMMANDS_BIT,
+                                                1000000000) : GL_WAIT_FAILED;
+        if (r != GL_ALREADY_SIGNALED && r != GL_CONDITION_SATISFIED && !finish_draws(p)) {
+            // The current draw also needs a reference if GL could not drain.
+            mp_image_new_ref(mpi);
+            return;
+        }
+        if (h->fence)
+            gl->DeleteSync(h->fence);
+        mp_image_unrefp(&h->mpi);
+        memmove(p->held, p->held + 1, (p->num_held - 1) * sizeof(p->held[0]));
+        p->num_held--;
+    }
+    struct mp_image *ref = mp_image_new_ref(mpi);
+    if (!ref) {
+        gl->Finish();
+        return;
+    }
+    p->held[p->num_held++] = (struct held_frame){
+        .mpi = ref,
+        .fence = gl->FenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0),
+    };
+}
