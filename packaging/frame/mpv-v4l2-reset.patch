+// Without native fences: lets go of the held frames the GPU is done with,
+// or of all after draining GL. A failed drain keeps their references alive.
+static void release_held(struct priv *p, bool all)
+{
+    GL *gl = held_gl(p);
+    if (all && p->num_held && !finish_draws(p))
+        return;
+    int n = 0;
+    for (; n < p->num_held; n++) {
+        struct held_frame *h = &p->held[n];
+        if (!all) {
+            if (!gl || !h->fence)
+                break;
+            GLenum r = gl->ClientWaitSync(h->fence, 0, 0);
+            if (r != GL_ALREADY_SIGNALED && r != GL_CONDITION_SATISFIED)
+                break;
+        }
+        if (gl && h->fence)
+            gl->DeleteSync(h->fence);
+        mp_image_unrefp(&h->mpi);
+    }
+    memmove(p->held, p->held + n, (p->num_held - n) * sizeof(p->held[0]));
+    p->num_held -= n;
+}
