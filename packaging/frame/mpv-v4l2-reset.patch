+static bool wait_fd(int fd)
+{
+    struct pollfd f = {.fd = fd, .events = POLLIN};
+    int r;
+    do {
+        r = poll(&f, 1, 1000);
+    } while (r < 0 && errno == EINTR);
+    return r > 0 && (f.revents & POLLIN) && !(f.revents & (POLLERR | POLLNVAL));
+}
+
+// Failure paths only. References survive a failed drain, even at shutdown.
+static bool finish_draws(struct priv *p)
+{
+    GL *gl = held_gl(p);
+    if (!gl)
+        return false;
+    gl->Finish();
+    return gl->GetError() == GL_NO_ERROR;
+}
