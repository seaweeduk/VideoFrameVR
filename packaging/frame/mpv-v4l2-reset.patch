+// Native fence fds and the releaser, where EGL offers them.
+static void check_fence_fds(struct render_backend *ctx, struct priv *p)
+{
+    p->fences_checked = true;
+    EGLDisplay dpy = eglGetCurrentDisplay();
+    const char *exts = dpy != EGL_NO_DISPLAY ? eglQueryString(dpy, EGL_EXTENSIONS) : NULL;
+    if (!exts || !strstr(exts, "EGL_ANDROID_native_fence_sync"))
+        goto fallback;
+    p->CreateSync = (PFNEGLCREATESYNCKHRPROC)eglGetProcAddress("eglCreateSyncKHR");
+    p->DestroySync = (PFNEGLDESTROYSYNCKHRPROC)eglGetProcAddress("eglDestroySyncKHR");
+    p->DupNativeFenceFD =
+        (PFNEGLDUPNATIVEFENCEFDANDROIDPROC)eglGetProcAddress("eglDupNativeFenceFDANDROID");
+    if (!p->CreateSync || !p->DestroySync || !p->DupNativeFenceFD)
+        goto fallback;
+    p->wake_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+    if (p->wake_fd < 0)
+        goto fallback;
+    pthread_mutex_init(&p->lock, NULL);
+    pthread_cond_init(&p->freed, NULL);
+    if (pthread_create(&p->releaser, NULL, releaser, p)) {
+        pthread_cond_destroy(&p->freed);
+        pthread_mutex_destroy(&p->lock);
+        close(p->wake_fd);
+        goto fallback;
+    }
+    p->fence_fds = true;
+    MP_VERBOSE(ctx, "Drawn hardware frames are released as their draws finish.\n");
+    return;
+fallback:
+    MP_VERBOSE(ctx, "No native fences: drawn hardware frames are released on later renders.\n");
+}
+
+// A native fence fd signalled once the commands so far are done, or -1.
+static int fence_fd(struct priv *p)
+{
+    EGLDisplay dpy = eglGetCurrentDisplay();
+    EGLSyncKHR sync = p->CreateSync(dpy, EGL_SYNC_NATIVE_FENCE_ANDROID, NULL);
+    if (sync == EGL_NO_SYNC_KHR)
+        return -1;
+    int fd = p->DupNativeFenceFD(dpy, sync);  // creating it flushed
+    p->DestroySync(dpy, sync);
+    return fd;
+}
