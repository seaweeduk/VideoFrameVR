+// Lets go of each held frame once its fence fd signals.
+static void *releaser(void *arg)
+{
+    struct priv *p = arg;
+    pthread_mutex_lock(&p->lock);
+    while (!p->quit) {
+        // render() only appends and this thread only removes: the first n
+        // entries stay the same while it waits.
+        struct pollfd fds[1 + MP_ARRAY_SIZE(p->held)];
+        int n = p->num_held;
+        fds[0] = (struct pollfd){.fd = p->wake_fd, .events = POLLIN};
+        for (int i = 0; i < n; i++)
+            fds[1 + i] = (struct pollfd){.fd = p->held[i].fd, .events = POLLIN};
+        pthread_mutex_unlock(&p->lock);
+        int r;
+        do {
+            r = poll(fds, 1 + n, -1);
+        } while (r < 0 && errno == EINTR);
+        if (r < 0)
+            usleep(1000);
+        uint64_t wakes;
+        if (fds[0].revents && read(p->wake_fd, &wakes, sizeof(wakes)) < 0) {
+            // nothing to read: woken anyway
+        }
+        struct held_frame done[MP_ARRAY_SIZE(p->held)];
+        int num_done = 0;
+        pthread_mutex_lock(&p->lock);
+        int kept = 0;
+        for (int i = 0; i < p->num_held; i++) {
+            if (r > 0 && i < n && (fds[1 + i].revents & POLLIN) &&
+                !(fds[1 + i].revents & (POLLERR | POLLNVAL)))
+                done[num_done++] = p->held[i];
+            else
+                p->held[kept++] = p->held[i];
+        }
+        p->num_held = kept;
+        if (!num_done)
+            continue;
+        p->num_releasing += num_done;
+        pthread_cond_broadcast(&p->freed);
+        pthread_mutex_unlock(&p->lock);
+        for (int i = 0; i < num_done; i++) {
+            close(done[i].fd);
+            mp_image_unrefp(&done[i].mpi);
+        }
+        pthread_mutex_lock(&p->lock);
+        p->num_releasing -= num_done;
+    }
+    pthread_mutex_unlock(&p->lock);
+    return NULL;
+}
