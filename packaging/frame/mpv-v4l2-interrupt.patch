+static void interrupt(struct mp_filter *vd, bool on)
+{
+    vd_ffmpeg_ctx *ctx = vd->priv;
+
+    mp_mutex_lock(&ctx->interrupt_lock);
+    atomic_store(&ctx->interrupted, on);
+    if (ctx->interrupt_avctx)
+        av_v4l2_m2m_set_interrupted(ctx->interrupt_avctx, on);
+    mp_mutex_unlock(&ctx->interrupt_lock);
+}
