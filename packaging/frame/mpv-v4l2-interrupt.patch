     p->has_broken_packet_pts = -10; // needs 10 packets to reach decision
@@ -453,7 +479,7 @@ static bool reinit_decoder(struct priv *
         struct mp_decoder_entry *sel = &list->entries[n];
         MP_VERBOSE(p, "Opening decoder %s\n", sel->decoder);
 
-        p->decoder = driver->create(p->decf, p->codec, sel->decoder);
+        set_decoder(p, driver->create(p->decf, p->codec, sel->decoder));
         if (p->decoder) {
             p->codec->decoder = talloc_strdup(p, sel->decoder);
             p->codec->decoder_desc = talloc_strdup(p, sel->desc && sel->desc[0] ? sel->desc : NULL);
@@ -1183,6 +1209,7 @@ static void public_f_destroy(struct mp_f
     talloc_free(p->dec_root_filter);
     talloc_free(p->queue);
     mp_mutex_destroy(&p->cache_lock);
+    mp_mutex_destroy(&p->decoder_lock);
 }
 
 static const struct mp_filter_info decf_filter = {
@@ -1211,6 +1238,14 @@ static void onlock_dec_thread(void *ptr)
     struct priv *p = ptr;
 
     mp_filter_graph_interrupt(p->dec_root_filter);
+
+    // A decoder waiting for frames to be returned would wait for this
+    // thread, which is about to wait for it (thread_unlock() ends this).
+    mp_mutex_lock(&p->decoder_lock);
+    p->decoder_interrupted = true;
+    if (p->decoder && p->decoder->interrupt)
+        p->decoder->interrupt(p->decoder->f, true);
+    mp_mutex_unlock(&p->decoder_lock);
 }
 
