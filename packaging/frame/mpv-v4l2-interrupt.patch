# Interrupt the decoder before locking its thread: a V4L2 decoder can wait there
# for frames that only the locking thread returns. Apply after mpv-v4l2-reset.patch.
--- a/filters/f_decoder_wrapper.c
+++ b/filters/f_decoder_wrapper.c
@@ -225,6 +225,12 @@ struct priv {
     bool dec_thread_valid;
     mp_mutex cache_lock;
 
+    // --- Protected by decoder_lock: the decoder as another thread wanting
+    //     the decoding thread interrupts it (onlock_dec_thread()). Set only
+    //     through set_decoder(), read freely by the decoding thread.
+    mp_mutex decoder_lock;
+    bool decoder_interrupted;
+
     // --- Protected by cache_lock.
     char *cur_hwdec;
     bool try_spdif;
@@ -290,8 +296,26 @@ static void thread_unlock(struct priv *p
     mp_assert(p->dec_thread_lock);
     p->dec_thread_lock = false;
 
-    if (p->dec_dispatch)
+    if (p->dec_dispatch) {
+        // The decoding thread is still held here, so it cannot be waiting.
+        mp_mutex_lock(&p->decoder_lock);
+        if (p->decoder_interrupted) {
+            p->decoder_interrupted = false;
+            if (p->decoder && p->decoder->interrupt)
+                p->decoder->interrupt(p->decoder->f, false);
+        }
+        mp_mutex_unlock(&p->decoder_lock);
         mp_dispatch_unlock(p->dec_dispatch);
+    }
+}
+
+static void set_decoder(struct priv *p, struct mp_decoder *decoder)
+{
+    mp_mutex_lock(&p->decoder_lock);
+    p->decoder = decoder;
+    if (decoder && decoder->interrupt && p->decoder_interrupted)
+        decoder->interrupt(decoder->f, true);
+    mp_mutex_unlock(&p->decoder_lock);
 }
 
 // This resets only the decoder. Unlike a full reset(), this doesn't imply a
@@ -371,8 +395,9 @@ static void decf_destroy(struct mp_filte
 
     if (p->decoder) {
         MP_DBG(f, "Uninit decoder.\n");
-        talloc_free(p->decoder->f);
-        p->decoder = NULL;
+        struct mp_decoder *decoder = p->decoder;
+        set_decoder(p, NULL);
+        talloc_free(decoder->f);
         p->codec->decoder = NULL;
         p->codec->decoder_desc = NULL;
     }
@@ -397,9 +422,10 @@ struct mp_decoder_list *audio_decoder_li
 
 static bool reinit_decoder(struct priv *p)
 {
-    if (p->decoder)
-        talloc_free(p->decoder->f);
-    p->decoder = NULL;
+    struct mp_decoder *old = p->decoder;
+    set_decoder(p, NULL);
+    if (old)
+        talloc_free(old->f);
 
