# Frame: AV1 on the Iris decoder that offers it (SteamOS 0.5.10): its capture pool,
# and software decoding when the hardware refuses a file.
--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -63,12 +63,13 @@ void frame_ubwc_decoder_closed(void);
 // Frame: the smallest picture area, by codec and bit depth, whose capture
 // pool the upstream Iris driver refused. Later sessions at least that large
 // take the smallest pool at once, so a seek or the next file doesn't fail first.
-static _Atomic int64_t v4l2_refused_area[2][2] = {{INT64_MAX, INT64_MAX}, {INT64_MAX, INT64_MAX}};
+static _Atomic int64_t v4l2_refused_area[3][2] = {{INT64_MAX, INT64_MAX}, {INT64_MAX, INT64_MAX},
+                                                  {INT64_MAX, INT64_MAX}};
 
 static _Atomic int64_t *v4l2_refused(const AVCodecParameters *par)
 {
     const AVPixFmtDescriptor *source = av_pix_fmt_desc_get(par->format);
-    return &v4l2_refused_area[par->codec_id == AV_CODEC_ID_HEVC]
+    return &v4l2_refused_area[par->codec_id == AV_CODEC_ID_AV1 ? 2 : par->codec_id == AV_CODEC_ID_HEVC]
                              [source && source->comp[0].depth > 8];
 }
 
