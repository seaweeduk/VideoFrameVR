# Linear NV12 instead of compressed 8-bit capture (Q08C) for a stream whose SPS
# crop changes the compressed layout, which importers derive from the visible size.
--- a/libavcodec/v4l2_buffers.h
+++ b/libavcodec/v4l2_buffers.h
@@ -157,5 +157,33 @@ ff_v4l2_buffer_set_avail(V4L2Buffer* con
     av_buffer_unref(&avbuf->ref_buf);
 }
 
+// A Qualcomm compressed frame of w x h, Q08C (NV12) or with ten Q10C (TP10):
+// each plane's compression metadata, then its tiles. The pitch and the
+// chroma plane's offset go out with the frame; an importer derives the
+// metadata sizes from the image size it is given.
+typedef struct V4L2UbwcSizes {
+    unsigned pitch, y_meta, uv_meta;
+    size_t uv_offset, size;
+} V4L2UbwcSizes;
+
+static inline V4L2UbwcSizes ff_v4l2_ubwc_sizes(const unsigned w, const unsigned h, const int ten)
+{
+    // Q10C is TP10: three 10-bit samples per 32-bit word. Its 192-pixel
+    // stride alignment is not a power of two and cannot use FFALIGN.
+    const unsigned pitch = ten ? ((w + 191) / 192) * 256 : FFALIGN(w, 128);
+    const unsigned uv_w = (w + 1) / 2, uv_h = (h + 1) / 2;
+    const unsigned tile_w = ten ? 48 : 32, tile_h = ten ? 4 : 8;
+    const unsigned uv_tile_w = tile_w / 2;
+    const unsigned y_meta = FFALIGN(FFALIGN((w + tile_w - 1) / tile_w, 64) *
+                                    FFALIGN((h + tile_h - 1) / tile_h, 16), 4096);
+    const unsigned uv_meta = FFALIGN(FFALIGN((uv_w + uv_tile_w - 1) / uv_tile_w, 64) *
+                                     FFALIGN((uv_h + tile_h - 1) / tile_h, 16), 4096);
+    const unsigned rows = ten ? 16 : 32;
+    const size_t y_size = FFALIGN((size_t)pitch * FFALIGN(h, rows), 4096);
+    const size_t uv_size = FFALIGN((size_t)pitch * FFALIGN(uv_h, rows), 4096);
+    return (V4L2UbwcSizes){pitch, y_meta, uv_meta, y_meta + y_size,
+                           y_meta + y_size + uv_meta + uv_size};
+}
+
 
 #endif // AVCODEC_V4L2_BUFFERS_H
