-    unsigned pitch = ten ? ((w + 191) / 192) * 256 : FFALIGN(w, 128);
-    unsigned uv_w = (w + 1) / 2, uv_h = (h + 1) / 2;
-    unsigned tile_w = ten ? 48 : 32, tile_h = ten ? 4 : 8;
-    unsigned uv_tile_w = tile_w / 2;
-    unsigned y_meta = FFALIGN(FFALIGN((w + tile_w - 1) / tile_w, 64) *
-                             FFALIGN((h + tile_h - 1) / tile_h, 16), 4096);
-    unsigned uv_meta = FFALIGN(FFALIGN((uv_w + uv_tile_w - 1) / uv_tile_w, 64) *
-                              FFALIGN((uv_h + tile_h - 1) / tile_h, 16), 4096);
-    unsigned rows = ten ? 16 : 32;
-    size_t y_size = FFALIGN((size_t)pitch * FFALIGN(h, rows), 4096);
-    size_t uv_size = FFALIGN((size_t)pitch * FFALIGN(uv_h, rows), 4096);
-    *out = (struct v4l2_ubwc_layout){pitch, y_meta + y_size,
-                                   y_meta + y_size + uv_meta + uv_size,
+    const V4L2UbwcSizes sizes = ff_v4l2_ubwc_sizes(w, h, ten);
+    *out = (struct v4l2_ubwc_layout){sizes.pitch, sizes.uv_offset, sizes.size,
                                    ten ? DRM_FORMAT_P010 : DRM_FORMAT_NV12};
     return 1;
 }
