                     ((V4L2m2mPriv *)avctx->priv_data)->source_pix_fmt = sps->pix_fmt;
@@ -1495,6 +1540,15 @@ static av_cold int v4l2_decode_init(AVCo
     }
     if (priv->capture_10bit)
         priv->capture_ubwc = 1;
+    // Q08C frames are laid out for the SPS's coded size, but importers
