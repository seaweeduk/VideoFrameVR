# CHANGELOG.md's format, which the app's What's new reads (src/whats_new.cpp).
#
# check_changelog(<file> <version>): with a release's version, a plain
# "0.2.0" (a leading "v" stripped), fails at the first line out of format,
# or when that version has no release with a line. With any other version
# ("dev-<time>-<commit>", "local-…") or none, a development build, any file
# is accepted.
#
# Also runs on its own, the version optional (the format is always checked,
# the version's notes only for a release's):
#   cmake -DCHANGELOG=CHANGELOG.md [-DVERSION=0.2.0] -P cmake/changelog.cmake

if(CMAKE_SCRIPT_MODE_FILE)
  cmake_minimum_required(VERSION 3.16)
endif()

# Whether YYYY-MM-DD is a day of the calendar.
function(_changelog_valid_date year month day out)
  set(${out} FALSE PARENT_SCOPE)
  math(EXPR month "${month}")
  math(EXPR day "${day}")
  if(month LESS 1 OR month GREATER 12 OR day LESS 1)
    return()
  endif()
  set(days 31)
  if(month EQUAL 4 OR month EQUAL 6 OR month EQUAL 9 OR month EQUAL 11)
    set(days 30)
  elseif(month EQUAL 2)
    math(EXPR by4 "${year} % 4")
    math(EXPR by100 "${year} % 100")
    math(EXPR by400 "${year} % 400")
    if(by400 EQUAL 0 OR (by4 EQUAL 0 AND NOT by100 EQUAL 0))
      set(days 29)
    else()
      set(days 28)
    endif()
  endif()
  if(NOT day GREATER days)
    set(${out} TRUE PARENT_SCOPE)
  endif()
endfunction()

function(_check_changelog file version strict)
  file(READ "${file}" text)
  # The app builds it in as a raw string closed by these.
  string(FIND "${text}" ")md\"" delimiter)
  if(NOT delimiter EQUAL -1)
    message(FATAL_ERROR "${file}: must not contain )md\"")
  endif()
  if(NOT strict)
    return()
  endif()

  set(sections New Improved Fixed Removed)
  set(state start)   # start, then heading, release, section
  set(comment FALSE)
  set(number 0)
  set(error "")
  set(previous_version "")
  set(previous_date "")
  set(release_number 0)
  set(release_heading "")
  set(release_sections 0)
  set(section_number 0)
  set(section_heading "")
  set(section_index -1)
  set(section_lines 0)
  set(found FALSE)
  set(more TRUE)
  while(more)
    string(FIND "${text}" "\n" end)
    if(end EQUAL -1)
      set(line "${text}")
      set(more FALSE)
    else()
      string(SUBSTRING "${text}" 0 ${end} line)
      math(EXPR end "${end} + 1")
      string(SUBSTRING "${text}" ${end} -1 text)
    endif()
    math(EXPR number "${number} + 1")
    string(REGEX REPLACE "\r$" "" line "${line}")

    if(comment)
      if(line MATCHES "-->")
        set(comment FALSE)
      endif()
      continue()
    endif()
    if(line MATCHES "^<!--")
      if(NOT line MATCHES "^<!--.*-->")
        set(comment TRUE)
      endif()
      continue()
    endif()
    if(line MATCHES "^[ \t]*$")
      continue()
    endif()

    if(state STREQUAL "start")
      if(NOT line STREQUAL "# Changelog")
        set(error "the file starts with \"# Changelog\"")
        break()
      endif()
      set(state heading)
    elseif(line MATCHES "^## ")
      if(NOT line MATCHES "^## (0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*) · ([0-9][0-9][0-9][0-9])-([0-9][0-9])-([0-9][0-9])$")
        set(error "a release is \"## <version> · <YYYY-MM-DD>\", such as \"## 0.2.0 · 2026-11-09\"")
        break()
      endif()
      set(release_version "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${CMAKE_MATCH_3}")
      set(release_date "${CMAKE_MATCH_4}-${CMAKE_MATCH_5}-${CMAKE_MATCH_6}")
      _changelog_valid_date(${CMAKE_MATCH_4} ${CMAKE_MATCH_5} ${CMAKE_MATCH_6} valid)
      if(NOT valid)
        set(error "${release_date} is not a date")
        break()
      endif()
      if(state STREQUAL "release")
        set(error "release ${previous_version} has no sections")
        set(number ${release_number})
        set(line "${release_heading}")
        break()
      endif()
      if(state STREQUAL "section" AND section_lines EQUAL 0)
        break()  # reported below
      endif()
      if(NOT previous_version STREQUAL "" AND NOT release_version VERSION_LESS previous_version)
        set(error "releases go newest first: ${release_version} comes after ${previous_version}")
        break()
      endif()
      if(NOT previous_date STREQUAL "" AND release_date STRGREATER previous_date)
        set(error "releases go newest first: ${release_date} comes after ${previous_date}")
        break()
      endif()
      if(release_version STREQUAL version)
        set(found TRUE)
      endif()
      set(previous_version "${release_version}")
      set(previous_date "${release_date}")
      set(release_number ${number})
      set(release_heading "${line}")
      set(section_index -1)
      set(section_lines 1)  # no section yet
      set(state release)
    elseif(line MATCHES "^### ")
      if(state STREQUAL "heading")
        set(error "a section comes after its release's \"## <version> · <YYYY-MM-DD>\"")
        break()
      endif()
      if(NOT line MATCHES "^### (New|Improved|Fixed|Removed)$")
        set(error "a section is \"### New\", \"### Improved\", \"### Fixed\" or \"### Removed\"")
        break()
      endif()
      if(section_lines EQUAL 0)
        break()  # reported below
      endif()
      list(FIND sections "${CMAKE_MATCH_1}" index)
      if(NOT index GREATER section_index)
        set(error "sections go New, Improved, Fixed, Removed, each once a release")
        break()
      endif()
      set(section_index ${index})
      set(section_number ${number})
      set(section_heading "${line}")
      set(section_lines 0)
      set(state section)
    elseif(line MATCHES "^- ")
      if(NOT state STREQUAL "section")
        set(error "a line comes after its section's \"### New\", \"### Improved\", \"### Fixed\" or \"### Removed\"")
        break()
      endif()
      if(line MATCHES "^- \\[(Frame|Desktop)\\] (.*)$")
        set(note "${CMAKE_MATCH_2}")
      elseif(line MATCHES "^- \\[")
        set(error "a line is marked \"[Frame] \" or \"[Desktop] \", or not at all")
        break()
      else()
        string(SUBSTRING "${line}" 2 -1 note)
      endif()
      if(NOT note MATCHES "^[^ \t]")
        set(error "a line has its text right after \"- \" (or its marker)")
        break()
      endif()
      math(EXPR section_lines "${section_lines} + 1")
    else()
      set(error "not a release (\"## \"), a section (\"### \") or a line (\"- \")")
      break()
    endif()
  endwhile()

  if(error STREQUAL "" AND state STREQUAL "section" AND section_lines EQUAL 0)
    set(error "section ${section_heading} of ${previous_version} has no lines")
    set(number ${section_number})
    set(line "${section_heading}")
  endif()
  if(error STREQUAL "" AND state STREQUAL "release")
    set(error "release ${previous_version} has no sections")
    set(number ${release_number})
    set(line "${release_heading}")
  endif()
  if(error STREQUAL "" AND comment)
    set(error "a comment (\"<!--\") is not closed (\"-->\")")
    set(line "")
  endif()
  if(error STREQUAL "" AND state STREQUAL "start")
    set(error "the file starts with \"# Changelog\"")
    set(line "")
  endif()
  if(NOT error STREQUAL "")
    if(line STREQUAL "")
      message(FATAL_ERROR "${file}:${number}: ${error}")
    else()
      message(FATAL_ERROR "${file}:${number}: ${error}\n    ${line}")
    endif()
  endif()
  if(NOT version STREQUAL "" AND NOT found)
    message(FATAL_ERROR "${file}: no release ${version} (\"## ${version} · <YYYY-MM-DD>\" "
                        "with its notes): a release build needs its notes")
  endif()
endfunction()

# A release's version: "0.2.0", or "v0.2.0".
function(_changelog_release_version version out)
  string(REGEX REPLACE "^v" "" version "${version}")
  if(version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    set(${out} "${version}" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

function(check_changelog file version)
  _changelog_release_version("${version}" release)
  if(release STREQUAL "")
    _check_changelog("${file}" "" FALSE)
  else()
    _check_changelog("${file}" "${release}" TRUE)
  endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT DEFINED CHANGELOG)
    message(FATAL_ERROR "usage: cmake -DCHANGELOG=CHANGELOG.md [-DVERSION=0.2.0] -P ${CMAKE_CURRENT_LIST_FILE}")
  endif()
  _changelog_release_version("${VERSION}" VERSION)
  _check_changelog("${CHANGELOG}" "${VERSION}" TRUE)
  message(STATUS "${CHANGELOG}: well-formed")
endif()
